{
  "crons": [
    {
      "path": "/api/prospecting-worker",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/media-brand/:leadId/:campaignId/:asset*",
      "destination": "/api/brand-asset?lid=:leadId&cid=:campaignId&asset=:asset*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
